# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter Base URL (usually don't need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use (OpenRouter format: provider/model)
# Examples:
#   openai/gpt-4o           - GPT-4o (recommended for vision)
#   openai/gpt-4o-mini      - GPT-4o Mini (faster, cheaper)
#   anthropic/claude-3.5-sonnet  - Claude 3.5 Sonnet
#   google/gemini-pro-1.5   - Gemini Pro 1.5
# See full list: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o

# Optional: Site info for OpenRouter analytics
SITE_URL=http://localhost:3000
SITE_NAME=Silver Surfer
